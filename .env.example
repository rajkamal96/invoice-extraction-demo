# Optional. Without a key the app runs in "recorded samples" mode: the three fictional samples work, uploads are off.
# Get a free key at https://aistudio.google.com/ and keep it server-side only.
GEMINI_API_KEY=

# Default is gemini-3.5-flash-lite (gemini-2.5-flash returned 404 for new API keys).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Only for tests against a local stub. Leave unset in production.
# GEMINI_API_BASE=

# Off switch: set to "false" and /api/extract returns 503 without calling the model.
# EXTRACT_ENABLED=true

# Limits for live model calls, per server instance (in memory).
# EXTRACT_MAX_PER_10_MIN=6
# EXTRACT_MAX_PER_DAY=100
